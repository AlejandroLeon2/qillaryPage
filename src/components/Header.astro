---
import TopBar from "./header/TopBar.astro";
import Logo from "./header/Logo.astro";
import Navigation from "./header/Navigation.astro";
import GoogleTranslator from "./header/GoogleTranslator.astro";
---

<header
  class="fixed top-0 left-0 max-w-screen bg-white z-30 md:flex md:flex-col h-19 md:h-20 shadow-sm w-full"
  aria-label="Main Navigation Header"
>
  <!-- Top Bar with Contact Info and Translator -->
  <TopBar>
    <GoogleTranslator slot="translator" />
  </TopBar>

  <!-- Main Navbar -->
  <section
    class="flex flex-wrap items-center justify-between md:justify-start bg-white h-20 px-4 lg:px-10"
  >
    <div class="flex w-full items-center justify-between">
      <!-- Branding / Logo -->
      <Logo />
      <!-- Navigation Menu (Desktop & Mobile) -->
      <Navigation />
      <!-- Mobile Menu Button -->
      <button
        id="close-menu"
        class="md:hidden mr-4 p-1 text-gray-800 hover:text-qillary-aqua transition-colors focus:outline-none"
        aria-label="Toggle Menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
          <line x1="4" y1="6" x2="20" y2="6"></line>
        </svg>
      </button>
    </div>
  </section>
</header>
