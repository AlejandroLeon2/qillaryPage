---
import MenuItem from "../ui/MenuItem.astro";
import { multidays } from "../../data/multiDays";
import { offRoadTours } from "../../data/offRoadTours";
import { peruTreks } from "../../data/peruTreks";
import { allTours } from "../../data/allTours";

function formatTours(tours, baseSlug) {
  return tours.map((tour) => {
    const slug = tour.name
      .toLowerCase()
      .replace(/&/g, "and")
      .replace(/[^\w\s-]/g, "")
      .replace(/\s+/g, "-");

    return {
      day: tour.duration,
      label: tour.name,
      href: `/${baseSlug}/${slug}`,
    };
  });
}

const menuData = [
  { label: "Home", href: "/" },
  { label: "Peru Treks", children: formatTours(peruTreks, "perutreks") },
  { label: "Tours", children: formatTours(allTours, "alltours") },
  {
    label: "Off Road Tours",
    children: formatTours(offRoadTours, "offroadtours"),
  },
  { label: "Multidays", children: formatTours(multidays, "multidays") },
  { label: "Contact Us", href: "/contacus" },
];
---

<nav
  id="mobile-menu"
  class="hidden fixed md:static top-[76px] md:top-auto left-0 w-full md:w-auto h-screen md:h-auto bg-white md:bg-transparent z-[60] md:z-auto md:flex md:items-center overflow-y-auto md:overflow-visible transition-all duration-300 ease-in-out"
>
  <ul
    id="menu-principal"
    class="flex justify-between flex-col md:flex-row w-full md:w-auto p-4 md:p-0 bg-white md:bg-transparent lg:gap-8 xl:gap-10"
  >
    {menuData.map((item) => <MenuItem {...item} />)}
  </ul>
</nav>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const menu = document.getElementById("menu-principal");
    const mobileMenuContainer = document.getElementById("mobile-menu");
    const toggleBtn = document.getElementById("close-menu");
    const links = document.querySelectorAll(".menu-link");

    if (!menu || !mobileMenuContainer) return;

    // Submenu click logic for mobile
    menu.addEventListener("click", (event) => {
      const target = event.target.closest(".escuchar");
      if (target && window.innerWidth < 768) {
        event.stopPropagation();
        const subMenu = target.nextElementSibling;
        const isOpen = subMenu && !subMenu.classList.contains("hidden");

        // Close all other submenus at the same level
        const siblingSubMenus = menu.querySelectorAll(".escuchar + ul");
        siblingSubMenus.forEach((s) => {
          if (s !== subMenu) {
            s.classList.add("hidden");
            s.classList.remove("grid");
          }
        });

        // Toggle current submenu
        if (subMenu) {
          if (isOpen) {
            subMenu.classList.add("hidden");
            subMenu.classList.remove("grid");
          } else {
            subMenu.classList.remove("hidden");
            subMenu.classList.add("grid");
          }
        }
      }
    });

    // Mobile menu toggle
    const toggleMenu = (e) => {
      if (e) e.stopPropagation();
      mobileMenuContainer.classList.toggle("hidden");
      // Prevent body scrolling when menu is open on mobile
      if (
        !mobileMenuContainer.classList.contains("hidden") &&
        window.innerWidth < 768
      ) {
        document.body.style.overflow = "hidden";
      } else {
        document.body.style.overflow = "";
      }
    };

    if (toggleBtn) {
      toggleBtn.addEventListener("click", toggleMenu);
    }

    // Close menu when clicking a link
    links.forEach((link) =>
      link.addEventListener("click", () => {
        if (window.innerWidth < 768) {
          mobileMenuContainer.classList.add("hidden");
          document.body.style.overflow = "";
        }
      }),
    );

    // Close menu when resizing to desktop
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        mobileMenuContainer.classList.add("hidden");
        document.body.style.overflow = "";
      }
    });
  });
</script>
