<div id="google_translate_element" class="translator-container h-10 flex items-center"></div>

<style is:global>
  /* Base cleanup for Google Translate UI */
  #google_translate_element {
    font-size: 0.8rem;
    line-height: normal;
  }

  /* Hide intrusive elements */
  .goog-te-banner-frame,
  .goog-te-gadget-icon,
  .skiptranslate[style*="top: 40px"],
  .skiptranslate[style*="top: 40px"] iframe {
    display: none !important;
  }
  
  body {
    top: 0 !important;
  }

  /* Premium Design for the Simple Gadget */
  .goog-te-gadget-simple {
    background-color: white !important;
    border: 1px solid #e5e7eb !important; /* gray-200 */
    padding: 6px 12px !important;
    border-radius: 8px !important;
    display: flex !important;
    align-items: center !important;
    cursor: pointer !important;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
  }

  .goog-te-gadget-simple:hover {
    background-color: #f9fafb !important;
    border-color: #3FD0D4 !important; /* qillary-aqua secondary color */
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;
  }

  .goog-te-gadget-simple span, 
  .goog-te-gadget-simple a {
    color: #1f2937 !important; /* gray-800 */
    font-weight: 600 !important;
    text-decoration: none !important;
    font-family: inherit !important;
  }

  /* Hide Google Icon */
  .goog-te-gadget-simple img {
    display: none !important;
  }

  /* Responsive styling */
  @media (max-width: 767px) {
    .goog-te-gadget-simple {
      background-color: #3FD0D4 !important; /* qillary-aqua main color on mobile */
      border: none !important;
    }
    .goog-te-gadget-simple span, 
    .goog-te-gadget-simple a {
      color: white !important;
    }
  }
</style>

<script is:inline>
  // Global initialization function required by Google
  window.googleTranslateElementInit = function() {
    new google.translate.TranslateElement(
      {
        pageLanguage: "en",
        includedLanguages: "es,en",
        layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
        autoDisplay: false
      },
      "google_translate_element"
    );
  };
</script>

<script is:inline>
  (function() {
    const initObserver = () => {
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          mutation.addedNodes.forEach((node) => {
            if (node.nodeType === 1 && (node.classList.contains('skiptranslate') || node.tagName === 'IFRAME')) {
              if (node.style.top === '40px' || node.id.includes('container')) {
                node.style.display = 'none';
              }
            }
          });
        });
      });

      observer.observe(document.body, { childList: true, subtree: true });
    };

    if (document.readyState === 'complete') {
      initObserver();
    } else {
      window.addEventListener('load', initObserver);
    }
  })();
</script>

<script 
  type="text/javascript" 
  src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" 
  async 
  defer
></script>
