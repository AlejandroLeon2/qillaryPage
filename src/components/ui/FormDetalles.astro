<form
  id="form"
  class="lg:max-w-xs h-fit mx-auto px-4 py-8 mt-15 bg-qillary-aqua text-white"
  aria-label="Formulario de reserva de tour"
  style="top: 20px; position: sticky;"
>
  <header class="text-center">
    <h2 class="text-2xl font-bold text-white">Book This Tour</h2>
    <p class="text-white">Arrange your trip in advance – book this tour now!</p>
  </header>

  <fieldset class="grid md:grid-cols-1 gap-4">
    <div class="relative">
      <i class="fas fa-user absolute left-3 top-1/2 -translate-y-1/2 text-white"
      ></i>
      <input
        type="text"
        name="name"
        id="name"
        required
        placeholder="Name *"
        class="placeholder:text-white pl-10 w-full p-2 bg-white/20 text-white rounded"
      />
    </div>

    <div class="relative">
      <i
        class="fas fa-phone absolute left-3 top-1/2 -translate-y-1/2 text-white"
      ></i>
      <input
        type="tel"
        name="phone"
        placeholder="Phone"
        class="pl-10 w-full p-2 bg-white/20 text-white placeholder-white rounded"
      />
    </div>

    <div class="relative">
      <i
        class="fas fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-white"
      ></i>
      <input
        type="text"
        name="email"
        id="email"
        required
        placeholder="Email *"
        class="pl-10 w-full p-2 bg-white/20 text-white placeholder-white rounded"
      />
    </div>

    <div class="relative">
      <i
        class="fas fa-calendar-day absolute left-3 top-1/2 -translate-y-1/2 text-white"
      ></i>
      <input
        type="text"
        name="time"
        id="time"
        placeholder="Date (dd-mm-yy)"
        class="pl-10 w-full p-2 bg-white/20 text-white placeholder-white rounded"
      />
    </div>
  </fieldset>

  <div class="relative">
    <i class="fas fa-comment-dots absolute left-3 top-3 text-white"></i>
    <textarea
      name="message"
      id="message"
      rows="4"
      placeholder="Message"
      class="pl-10 pt-2 w-full p-2 bg-white/20 text-white placeholder-white rounded"
    ></textarea>
  </div>

  <div class="flex flex-col justify-center gap-4 pt-4">
    <input
      type="submit"
      id="button"
      value="Send Email"
      placeholder="check Availability"
      class="w-full md:w-auto duration-300 cursor-pointer px-12 py-4 bg-cyan-950 text-white rounded-sm font-black uppercase tracking-widest hover:bg-white hover:text-cyan-950 active:bg-cyan-950 active:text-white hover:scale-105 active:scale-95 transition-all shadow-xl shadow-cyan-900/30"
    />
  </div>
</form>

<script>
  const form = document.getElementById("form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", async function (event) {
      event.preventDefault();

      const btn = document.getElementById("button") as HTMLInputElement;
      if (btn) btn.value = "Sending...";

      // Target URL for Google Form submission
      const googleFormUrl =
        "https://docs.google.com/forms/d/e/1FAIpQLSevkyqAnekQSsQ1Hfg-94ADpnpWYeFEvN9oonTr8MiYtaKLsw/formResponse";

      const formData = new FormData(this);

      // Prepare Google Form submission payloads using their specific entry IDs
      const googleFormData = new URLSearchParams();
      googleFormData.append(
        "entry.1895530568",
        formData.get("name")?.toString() || "",
      );
      googleFormData.append(
        "entry.1479455098",
        formData.get("phone")?.toString() || "",
      );
      googleFormData.append(
        "entry.2001265092",
        formData.get("email")?.toString() || "",
      );
      googleFormData.append(
        "entry.1469682395",
        formData.get("message")?.toString() || "",
      );

      const dateStr = formData.get("time")?.toString() || "";
      if (dateStr) {
        // Format expected from placeholder: 'dd-mm-yy'
        const parts = dateStr.split(/[-/\.]/);
        if (parts.length >= 3) {
          googleFormData.append("entry.2115973432_day", parts[0]);
          googleFormData.append("entry.2115973432_month", parts[1]);
          let year = parts[2];
          if (year.length === 2) year = "20" + year;
          googleFormData.append("entry.2115973432_year", year);
        }
      }

      // Execute Google Forms POST with mode: 'no-cors'
      const googleFormsPromise = fetch(googleFormUrl, {
        method: "POST",
        mode: "no-cors",
        body: googleFormData,
      });

      // Execute EmailJS
      const serviceID = "service_hfeo2xd";
      const templateID = "template_3cdp8t7";
      // @ts-ignore - Assuming emailjs is loaded globally via Secundario.astro
      const emailjsPromise = emailjs.sendForm(
        serviceID,
        templateID,
        this,
        "jRYXHpsbqwdF76a3Q",
      );

      try {
        await Promise.all([googleFormsPromise, emailjsPromise]);
        if (btn) btn.value = "Send Email";
        alert("Message sent successfully!");
        form.reset();
      } catch (err) {
        if (btn) btn.value = "Send Email";
        alert("Failed to send message. Error: " + JSON.stringify(err));
      }
    });
  }
</script>
