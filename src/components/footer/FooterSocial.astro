---
const { social } = Astro.props;
---

<div class="col-span-1">
  <h3 class="text-white font-bold text-lg mb-6 border-b-2 border-qillary-aqua w-fit">
    Follow Us
  </h3>
  <p class="text-sm text-gray-400 mb-6 italic">
    Stay updated with our latest adventures and exclusive travel deals!
  </p>
  
  <ul class="space-y-4">
    <!-- Facebook -->
    <li>
      <a
        href={social.facebook.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Qillary Tours Facebook"
        class="flex items-center gap-4 group"
      >
        <div class="w-10 h-10 flex items-center justify-center bg-gray-800 rounded-full group-hover:bg-[#1877F2] group-hover:scale-110 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 320 512">
            <path d="M80 299.3V512H196V299.3h86.5l18-97.8H196V144c0-26.9 7.3-45.4 46.2-45.4h49.4V11c-8.5-1.1-37.7-3.7-71.7-3.7C209.2 7.3 131.8 46.4 131.8 132.2v69.3H40v97.8h91.8z"/>
          </svg>
        </div>
        <span class="text-gray-400 group-hover:text-white transition-colors">Facebook</span>
      </a>
    </li>

    <!-- Instagram -->
    <li>
      <a
        href={social.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Qillary Tours Instagram"
        class="flex items-center gap-4 group"
      >
        <div class="w-10 h-10 flex items-center justify-center bg-gray-800 rounded-full group-hover:bg-gradient-to-tr group-hover:from-amber-600 group-hover:via-pink-500 group-hover:to-indigo-600 group-hover:scale-110 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
        </div>
        <span class="text-gray-400 group-hover:text-white transition-colors">Instagram</span>
      </a>
    </li>

    <!-- TikTok -->
    <li>
      <a
        href={social.tiktok.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Qillary Tours TikTok"
        class="flex items-center gap-4 group"
      >
        <div class="w-10 h-10 flex items-center justify-center bg-gray-800 rounded-full group-hover:bg-[#000000] group-hover:scale-110 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 448 512">
            <path d="M448 209.91a210.06 210.06 0 01-122.77-39.25V349.38A162.55 162.55 0 11185 188.31V278.2a74.62 74.62 0 1052.23 71.18V0l88 0a121.18 121.18 0 001.86 22.17h0A122.18 122.18 0 00381 102.39a121.43 121.43 0 0067 20.14z"/>
          </svg>
        </div>
        <span class="text-gray-400 group-hover:text-white transition-colors">TikTok</span>
      </a>
    </li>
  </ul>
</div>
