---
const { brand, description } = Astro.props;
---

<div class="flex flex-col items-center md:items-start text-center md:text-left col-span-1">
  <img
    src={brand.logo}
    alt={brand.logoAlt}
    title={brand.name}
    class="w-64 lg:w-80 mb-6 drop-shadow-md"
    loading="lazy"
  />
  <p class="leading-relaxed text-gray-400 max-w-sm mb-4 text-balanced">
    {description}
  </p>
</div>
