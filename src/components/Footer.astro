---
import { qillary } from "../data/qillary";
import FooterBrand from "./footer/FooterBrand.astro";
import FooterContacts from "./footer/FooterContacts.astro";
import FooterSocial from "./footer/FooterSocial.astro";
import FooterInstagram from "./footer/FooterInstagram.astro";
import FooterCopyright from "./footer/FooterCopyright.astro";

const { brand, contact } = qillary;
---

<footer class="bg-qillary-dark text-white font-sans overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 lg:pt-32">
    <!-- Main Grid Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Section 1: Brand & Logo -->
      <FooterBrand 
        brand={brand} 
        description={contact.labels.description} 
      />

      <!-- Section 2: Offices & Contacts -->
      <FooterContacts 
        offices={contact.offices}
        emails={contact.emails}
        phones={contact.phones}
      />

      <!-- Section 3: Social Networks -->
      <FooterSocial 
        social={contact.social} 
      />

      <!-- Section 4: Travel Gallery / Description -->
      <FooterInstagram 
        social={contact.social.instagram} 
      />
    </div>

    <!-- Bottom Bar: Copyright & Languages -->
    <FooterCopyright />
  </div>
  
  <!-- Subtle background decoration if needed -->
  <div class="absolute inset-0 pointer-events-none opacity-5">
    <!-- Possible SVG decoration or texture -->
  </div>
</footer>
