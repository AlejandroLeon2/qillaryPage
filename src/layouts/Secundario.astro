---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { qillary } from "../data/qillary";
import Instagram from "../components/dynamic/Instagram.astro";
import Whatsapp from "../components/dynamic/Whatsapp.astro";
import Messenger from "../components/dynamic/Messenger.astro";

const { title, description, url } = Astro.props;
---

<html lang="en">
  <head>
    <!-- Charset and viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Dynamic SEO -->
    <title>{title} | Explore Peru with Qillary Tours</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content={`Qillary Tours, Peru travel, ${title}, Machu Picchu tours, Andes adventures, cultural experiences`}
    />
    <meta name="author" content="Qillary Tours" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical (points to current tour URL) -->
    <link rel="canonical" href={url} />

    <!-- Open Graph for social media -->
    <meta property="og:site_name" content="Qillary Tours" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={url} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@qillarytours" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <link
      media="print"
      onload="this.media='all'"
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <!-- Preconexión para mejorar el rendimiento -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Catamaran: pesos 100–900 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Catamaran:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Satisfy: cursiva decorativa -->
    <link
      href="https://fonts.googleapis.com/css2?family=Satisfy&display=swap"
      rel="stylesheet"
    />

    <!-- Poetsen One + Poppins: pesos múltiples + estilos -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poetsen+One&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <script src="https://code.iconify.design/2/2.2.1/iconify.min.js"></script>
  </head>
  <body class="poppins">
    <Header />
    <main class="overflow-hidden">
      <slot />

      <button
        id="btn"
        title="Open contact panel"
        class="fixed bottom-5 right-1 md:right-5 z-50 px-2 py-2 rounded-full bg-amber-400 duration-500 flex items-center justify-center"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-10 w-10"
          ><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path><path d="M8 12h.01"
          ></path><path d="M12 12h.01"></path><path d="M16 12h.01"></path></svg
        >
      </button>

      <div
        id="mover"
        class="fixed flex flex-col space-y-1 duration-300 translate-y-80 z-50 bottom-5 right-1 md:right-5"
      >
        <button
          id="btn-cerrar"
          class="text-center active:scale-95 hover:scale-105"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-full h-10 text-amber-400"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg></button
        >
        <Instagram data={qillary} />
        <Messenger data={qillary} />
        <Whatsapp data={qillary} />
      </div>
    </main>
    <Footer />
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"
    ></script>
    <script type="text/javascript">
      emailjs.init("jRYXHpsbqwdF76a3Q");
    </script>
  </body>
</html>
<script is:inline>
  const btn = document.getElementById("btn");
  const mover = document.getElementById("mover");
  const cerrar = document.getElementById("btn-cerrar");
  btn.addEventListener("click", () => {
    mover.classList.toggle("translate-y-80");
    btn.classList.toggle("translate-y-80");
  });
  cerrar.addEventListener("click", () => {
    mover.classList.toggle("translate-y-80");
    btn.classList.toggle("translate-y-80");
  });
  document.addEventListener("DOMContentLoaded", () => {
    if (btn && mover) {
      setTimeout(() => {
        mover.classList.toggle("translate-y-80");
        btn.classList.toggle("translate-y-80");
      }, 15000);
    }
  });
</script>
