---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Instagram from "../components/dynamic/Instagram.astro";
import Whatsapp from "../components/dynamic/Whatsapp.astro";
import Messenger from "../components/dynamic/Messenger.astro";
import { qillary } from "../data/qillary";
---

<html lang="en">
  <!-- Idioma configurado a español, esencial para SEO y accesibilidad regional -->
  <head>
    <!-- Charset & viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Generated by Astro -->
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Essentials -->
    <title>Trips to Machu Picchu & Peru | Qillary Tours</title>
    <meta
      name="description"
      content="Discover Peru with Qillary Tours. Explore Machu Picchu, Cusco, the Sacred Valley, the Amazon, and more with our unique travel packages."
    />
    <meta
      name="keywords"
      content="Qillary Tours, Peru travel packages, Machu Picchu tours, Sacred Valley, adventure in Peru, Inca history, cultural trips"
    />
    <meta name="author" content="Qillary Tours" />

    <!-- Open Graph for social sharing -->
    <meta property="og:site_name" content="Qillary Tours" />
    <meta
      property="og:title"
      content="Trips to Machu Picchu & Peru | Qillary Tours"
    />
    <meta
      property="og:description"
      content="Join unforgettable journeys through Peru. Explore iconic destinations like Machu Picchu, Cusco, and the Andes with expert local guides."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://qillary.tours/" />
    <meta
      property="og:image"
      content="https://qillary.tours/images/TREK3_.webp"
    />
    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://qillary.tours/" />

    <!-- Preload LCP image -->
    <link as="image" href="/images/TREK3_.webp" fetchpriority="high" />

    <meta name="robots" content="index, follow" />

    <!-- Preconexión para mejorar el rendimiento -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Satisfy: cursiva decorativa -->
    <link
      href="https://fonts.googleapis.com/css2?family=Satisfy&display=swap"
      rel="stylesheet"
    />

    <!-- Poetsen One + Poppins: pesos múltiples + estilos -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poetsen+One&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="poppins">
    <Header />
    <main class="overflow-hidden">
      <slot />
      <button
        id="btn"
        title="Open contact panel"
        class="fixed bottom-5 right-1 md:right-5 z-50 px-2 py-2 rounded-full bg-amber-400 duration-500 flex items-center justify-center"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-10 w-10"
          ><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path><path d="M8 12h.01"
          ></path><path d="M12 12h.01"></path><path d="M16 12h.01"></path></svg
        >
      </button>

      <div
        id="mover"
        class="fixed flex flex-col space-y-1 duration-300 translate-y-60 z-50 bottom-5 right-1 md:right-5"
      >
        <button
          id="btn-cerrar"
          class="text-center active:scale-95 hover:scale-105"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-full h-10 text-amber-400"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg></button
        >
        <Instagram data={qillary} />
        <Messenger data={qillary} />
        <Whatsapp data={qillary} />
      </div>
    </main>
    <Footer />

    <script
      defer
      fetchpriority="low"
      src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
    ></script>
  </body>
</html>
<script is:inline>
  const btn = document.getElementById("btn");
  const mover = document.getElementById("mover");
  const cerrar = document.getElementById("btn-cerrar");
  btn.addEventListener("click", () => {
    mover.classList.toggle("translate-y-60");
    btn.classList.toggle("translate-y-60");
  });
  cerrar.addEventListener("click", () => {
    mover.classList.toggle("translate-y-60");
    btn.classList.toggle("translate-y-60");
  });
  document.addEventListener("DOMContentLoaded", () => {

    
    if (btn && mover) {
      setTimeout(() => {
        mover.classList.toggle("translate-y-60");
        btn.classList.toggle("translate-y-60");
      }, 15000);
    }
  });
</script>
